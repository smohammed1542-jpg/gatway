# Django
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-long-random-secret-at-least-40-chars
DEBUG=False
ALLOWED_HOSTS=your-api.example.com,localhost,127.0.0.1

# Public signup creates a new Tenant + ADMIN — keep false in production
ALLOW_PUBLIC_REGISTRATION=false

# HTTPS (set true behind TLS / Railway / public internet)
USE_HTTPS=true
SECURE_SSL_REDIRECT=true

# Database — PostgreSQL required when DEBUG=False (no silent SQLite fallback)
# Prefer DATABASE_URL on Railway; or set DB_* for Docker Compose
DATABASE_URL=
DB_SSL=true
DB_NAME=hallora
DB_USER=hallora
DB_PASSWORD=replace-with-strong-db-password
DB_HOST=localhost
DB_PORT=5432
# Local SQLite-only exception (never for production): ALLOW_SQLITE=true

# CORS / CSRF — list exact frontend origins (no wildcards by default)
# On Railway set FRONTEND_URL=https://your-app.vercel.app (auto-added to CORS/CSRF)
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
FRONTEND_URL=
CSRF_TRUSTED_ORIGINS=https://your-frontend.example.com,https://your-api.example.com
# Optional only if you need Vercel preview deploys:
# CORS_ALLOW_VERCEL_PREVIEWS=true

# Railway API-only (frontend on Vercel)
SERVE_FRONTEND=false

# Optional Cloudinary (recommended on ephemeral hosts)
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Throttles (optional overrides)
# DRF_THROTTLE_ANON=60/min
# DRF_THROTTLE_USER=600/min
# DRF_THROTTLE_LOGIN=20/min

# Notifications
NOTIFICATION_BACKEND=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# First-install / password reset on Railway (backend Variables — never commit real passwords)
# APPLY_ADMIN_PASSWORD=true  → sets admin password from SEED_ADMIN_PASSWORD on each deploy
# After login works, set APPLY_ADMIN_PASSWORD=false
# RUN_SEED_ON_START=true     → also seeds landing page content
# SEED_ADMIN_PASSWORD=       → strong password, 12+ characters (set in Railway only)
